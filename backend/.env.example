# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/whatsapp_clone

# Auth - Access token (short-lived, sent with every request)
JWT_SECRET=change_this_to_a_long_random_secret_string
ACCESS_TOKEN_EXPIRES_IN=15m

# Auth - Refresh token (long-lived, used only to mint new access tokens)
# MUST be a different secret than JWT_SECRET
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret_string
REFRESH_TOKEN_EXPIRES_IN=30d

# Message encryption (AES-256, at-rest encryption of message text)
# Must be exactly 32 characters long
MESSAGE_ENCRYPTION_KEY=change_this_to_a_32_char_secret!

# CORS - comma separated list of allowed origins, or * for all
CORS_ORIGIN=*
